{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Release, ccache when available",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "DWARFS_PREFIX": "/usr/local"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Debug, AddressSanitizer + UndefinedBehaviorSanitizer, tests",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "RWZFS_SANITIZE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 0
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_leaks=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "execution": {
        "jobs": 0
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
